            "default": {
              "text": {
                "en": "Prescribing information for SCEMBLIX® ▼ (asciminib) can be found {{pi_link}} (external link)."
              },
              "placeholders": [
                { "key": "pi_link", "kind": "external_link", "anchorText": "here", "uri": "https://www.medicines.org.uk/emc/product/12345/smpc" }
